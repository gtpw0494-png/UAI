{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intraultuniversalion.local/schemas/plugin-manifest-v1.json",
  "title": "UAI Plugin Manifest v1",
  "type": "object",
  "required": ["id","name","version","entrypoint","capabilities","permissions","risk","timeoutMs","provenance"],
  "properties": {
    "id": {"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{1,127}$"},
    "name": {"type":"string","minLength":1,"maxLength":128},
    "version": {"type":"string","minLength":1,"maxLength":64},
    "entrypoint": {"type":"string","minLength":1,"maxLength":512},
    "capabilities": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "permissions": {
      "type":"object",
      "required":["filesystem","network","process"],
      "properties": {
        "filesystem":{"type":"object","required":["read","write"],"properties":{"read":{"type":"array","items":{"type":"string"}},"write":{"type":"array","items":{"type":"string"}}}},
        "network":{"type":"object","required":["allow"],"properties":{"allow":{"type":"array","items":{"type":"string"}}}},
        "process":{"type":"object","required":["spawn"],"properties":{"spawn":{"type":"boolean"}}}
      },
      "additionalProperties": false
    },
    "risk": {"enum":["low","medium","high","critical"]},
    "timeoutMs": {"type":"integer","minimum":100,"maximum":300000},
    "reversible": {"type":"boolean"},
    "provenance": {"type":"object","required":["source","sha256"],"properties":{"source":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"}}},
    "signature": {"type":["object","null"],"properties":{"algorithm":{"const":"ed25519"},"publicKeyPem":{"type":"string"},"signatureBase64":{"type":"string"}}}
  },
  "additionalProperties": true
}
