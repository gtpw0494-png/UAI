{
  "name": "intraultuniversalion",
  "version": "0.34.0",
  "private": true,
  "description": "Durable orchestration release: persisted task state, governed action envelopes, explicit resume/cancel recovery, availability evidence, and GitHub public-repository privacy hardening.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node test.js",
    "test:model": "python3 model/test_forgelm.py",
    "model:status": "python3 model/cli.py status",
    "model:train": "python3 model/cli.py train --steps 80 --preset termux-tiny",
    "model:train:direct": "python3 model/trainer.py --preset termux-tiny --steps 80",
    "learning:export": "node scripts/export-learning.js",
    "deps:status": "python3 model/dependency_status.py",
    "dataset:build": "python3 model/data_pipeline.py",
    "model:benchmark": "python3 model/benchmark_inference.py",
    "tokenizer:train": "python3 model/tokenizer.py train --vocab-size 512",
    "tokenizer:status": "python3 model/tokenizer.py status",
    "sources:analyze": "python3 research/analyze_sources.py",
    "hardware:status": "python3 model/hardware_profile.py",
    "release:manifest": "python3 scripts/build-release-manifest.py",
    "web:status": "node scripts/web-status.js",
    "web:ingest": "node scripts/web-ingest.js",
    "web:import": "python3 research/import_web_corpus.py",
    "corpus:build": "python3 model/build_corpus.py",
    "capabilities:probe": "node scripts/probe-capabilities.js",
    "capabilities:termux": "bash scripts/enable-termux-capabilities.sh",
    "storage:init": "python3 storage/db.py init",
    "storage:status": "python3 storage/db.py status",
    "language:fetch": "bash scripts/fetch-language-data.sh",
    "language:import:wordnet": "python3 research/import_wordnet.py",
    "language:import:oasst1": "python3 research/import_oasst1.py",
    "language:export": "python3 storage/export_training.py",
    "semantic:build": "python3 storage/semantic.py build",
    "semantic:search": "python3 storage/semantic.py search --query",
    "lexicon:related": "python3 storage/db.py related --term"
  },
  "engines": {"node": ">=20"},
  "optionalDependencies": {
    "@langchain/core": "1.2.12",
    "@langchain/langgraph": "1.4.17",
    "zod": "4.6.5"
  }
}
