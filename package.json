{
  "name": "intraultuniversalion",
  "version": "0.54.0",
  "private": true,
  "description": "Independent local-first AI operating environment with user-owned memory, provenance, evidence-native research, typed agent scheduling, policy simulation, verified model artifacts, evaluation records, local model routing and owner-governed promotion.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node test.js",
    "test:model": "python3 model/test_forgelm.py",
    "model:status": "python3 model/cli.py status",
    "model:train": "python3 model/cli.py train --steps 80 --preset termux-tiny",
    "model:train:direct": "python3 model/trainer.py --preset termux-tiny --steps 80",
    "learning:export": "node scripts/export-learning.js",
    "deps:status": "python3 model/dependency_status.py",
    "dataset:build": "python3 model/data_pipeline.py",
    "model:benchmark": "python3 model/benchmark_inference.py",
    "tokenizer:train": "python3 model/tokenizer.py train --vocab-size 512",
    "tokenizer:status": "python3 model/tokenizer.py status",
    "sources:analyze": "python3 research/analyze_sources.py",
    "hardware:status": "python3 model/hardware_profile.py",
    "release:manifest": "python3 scripts/build-release-manifest.py",
    "web:status": "node scripts/web-status.js",
    "web:ingest": "node scripts/web-ingest.js",
    "web:import": "python3 research/import_web_corpus.py",
    "corpus:build": "python3 model/build_corpus.py",
    "capabilities:probe": "node scripts/probe-capabilities.js",
    "capabilities:termux": "bash scripts/enable-termux-capabilities.sh",
    "storage:init": "python3 storage/db.py init",
    "storage:status": "python3 storage/db.py status",
    "language:fetch": "bash scripts/fetch-language-data.sh",
    "language:import:wordnet": "python3 research/import_wordnet.py",
    "language:import:oasst1": "python3 research/import_oasst1.py",
    "language:export": "python3 storage/export_training.py",
    "semantic:build": "python3 storage/semantic.py build",
    "semantic:search": "python3 storage/semantic.py search --query",
    "lexicon:related": "python3 storage/db.py related --term",
    "test:security": "node security-test.js",
    "adaptation:status": "python3 model/adaptation.py status",
    "continual:snapshot": "python3 model/continual.py snapshot",
    "data:lifecycle": "python3 storage/lifecycle.py status",
    "retrieval:eval": "python3 storage/retrieval_eval.py",
    "test:control-plane": "node verification/control-plane-modernization.test.mjs",
    "test:plugin-gateway": "node verification/plugin-gateway.test.mjs",
    "test:plugin-http": "node verification/plugin-http.test.mjs",
    "test:document-data": "python3 verification/document-data-plane.test.py",
    "test:document-http": "node verification/document-http.test.mjs",
    "documents:status": "python3 storage/documents.py status",
    "documents:reindex": "python3 storage/documents.py reindex",
    "test:api-security": "node verification/api-security-v046.test.mjs",
    "test:conversation-capability": "node verification/conversation-capability-v048.test.mjs",
    "test:model-router-evidence": "node verification/model-router-evidence-v049.test.mjs",
    "test:owner-auth": "node verification/owner-bootstrap-v049.test.mjs",
    "owner:configure": "node scripts/configure-owner.mjs",
    "owner:run": "bash scripts/run-owner-local.sh",
    "test:conversation-research": "node verification/conversation-research-v050.test.mjs",
    "test:conversation-memory": "node verification/conversation-memory-v051.test.mjs",
    "test:shadow-light": "node verification/shadow-light-v052.test.mjs",
    "shadow:status": "node scripts/shadow-cli.js status",
    "shadow:agents": "node scripts/shadow-cli.js agents",
    "shadow:runs": "node scripts/shadow-cli.js runs",
    "light:status": "node scripts/light-cli.js status",
    "light:agents": "node scripts/light-cli.js agents",
    "light:patches": "node scripts/light-cli.js patches",
    "test:shadow-light-http": "node verification/shadow-light-http-v052.test.mjs",
    "test:agent-control": "node verification/agent-control-v053.test.mjs",
    "test:agent-control-http": "node verification/agent-control-http-v053.test.mjs",
    "control:status": "node scripts/control-plane-cli.js status",
    "control:jobs": "node scripts/control-plane-cli.js jobs",
    "control:dispatch": "node scripts/control-plane-cli.js dispatch",
    "control:maintenance": "node scripts/control-plane-cli.js maintenance",
    "test:platform-intelligence": "node verification/platform-intelligence-v054.test.mjs",
    "test:platform-intelligence-http": "node verification/platform-intelligence-http-v054.test.mjs",
    "platform:status": "node scripts/platform-intelligence-cli.js status",
    "memory:status": "node scripts/platform-intelligence-cli.js memory-status",
    "provenance:status": "node scripts/platform-intelligence-cli.js provenance-status",
    "evaluations:status": "node scripts/platform-intelligence-cli.js evaluations",
    "test:knowledge-autonomy": "node verification/knowledge-autonomy-v055.test.mjs",
    "knowledge:benchmark": "python3 model/eval/knowledge_benchmark.py",
    "knowledge:store": "python3 model/knowledge_store.py",
    "test:cloud-knowledge": "node verification/cloud-knowledge-store.test.mjs",
    "test:knowledge-training-job": "node verification/knowledge-training-job.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "@langchain/core": "1.2.12",
    "@langchain/langgraph": "1.4.17",
    "zod": "4.6.5"
  }
}
